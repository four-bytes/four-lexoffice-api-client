{
    "name": "four-bytes/four-lexoffice-api-client",
    "description": "PHP client for the lexoffice/Lexware Office API v1",
    "type": "library",
    "version": "0.5.0",
    "license": "MIT",
    "keywords": [
        "lexoffice",
        "lexware",
        "accounting",
        "api-client",
        "invoicing"
    ],
    "authors": [
        {
            "name": "Four Bytes",
            "homepage": "https://github.com/four-bytes"
        }
    ],
    "require": {
        "php": ">=8.2",
        "four-bytes/four-http-client": "^4.0",
        "four-bytes/four-rate-limiting": "^1.3",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Alternative PSR-18 HTTP client implementation",
        "symfony/http-client": "PSR-18 HTTP client implementation"
    },
    "autoload": {
        "psr-4": {
            "Four\\LexofficeApiClient\\": "src/Four/LexofficeApiClient/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Four\\LexofficeApiClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse src tests --level=6",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
