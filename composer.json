{
    "name": "four-bytes/four-lexware-api-client",
    "description": "PHP 8.4+ client for the Lexware Office API (formerly Lexoffice) with rate limiting and retry",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "lexware",
        "lexware-office",
        "lexoffice",
        "accounting",
        "invoicing",
        "api-client",
        "php"
    ],
    "authors": [
        {
            "name": "Four Bytes",
            "homepage": "https://github.com/four-bytes"
        }
    ],
    "support": {
        "issues": "https://github.com/four-bytes/four-lexware-api-client/issues",
        "source": "https://github.com/four-bytes/four-lexware-api-client"
    },
    "require": {
        "php": "^8.4",
        "four-bytes/four-http-client": "^4.0 || ^5.0",
        "four-bytes/four-rate-limiting": "^1.3",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Alternative PSR-18 HTTP client implementation",
        "symfony/http-client": "PSR-18 HTTP client implementation"
    },
    "autoload": {
        "psr-4": {
            "Four\\LexwareApiClient\\": "src/Four/LexwareApiClient/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Four\\LexwareApiClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse src tests --level=6",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
